import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, SimpleRNN, Dense
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences

# Sample training data
sentences = [
    "I eat apples",
    "She reads books",
    "They play football",
    "He likes music"
]

# Simplified illustrative labels, one per token
labels = [
    [1, 2, 3],
    [1, 2, 3],
    [1, 2, 3],
    [1, 2, 3]
]

# Tokenize sentences
tokenizer = Tokenizer()
tokenizer.fit_on_texts(sentences)
X = tokenizer.texts_to_sequences(sentences)
X = pad_sequences(X, padding="post")

# Prepare labels
y = np.array(labels)

# Build RNN model
model = Sequential([
    Embedding(input_dim=len(tokenizer.word_index) + 1,
              output_dim=8,
              input_length=X.shape[1]),
    SimpleRNN(16, return_sequences=True),
    Dense(4, activation="softmax")
])

# Compile and train
model.compile(optimizer="adam",
              loss="sparse_categorical_crossentropy",
              metrics=["accuracy"])

model.fit(X, y, epochs=50, verbose=0)

# Predict dependency labels
prediction = model.predict(X[:1], verbose=0)

print("Input Sentence:", sentences[0])
print("Predicted Dependency Labels:")

for word, scores in zip(sentences[0].split(), prediction[0]):
    print(word, ":", np.argmax(scores))
